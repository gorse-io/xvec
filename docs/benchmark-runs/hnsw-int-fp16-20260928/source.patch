+#include "textflag.h"
+
+// Each address is the start of a cache line within the validated code slice.
+TEXT ·prefetchQuantizedCacheLines(SB), NOSPLIT, $0-16
+ MOVQ base+0(FP), AX
+ MOVQ lines+8(FP), CX
+ TESTQ CX, CX
+ JE done
+loop:
+ PREFETCHT0 (AX)
+ ADDQ $64, AX
+ DECQ CX
+ JNZ loop
+done:
+ RET
